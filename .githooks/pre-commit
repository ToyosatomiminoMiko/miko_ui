#!/usr/bin/env python3
# ============================================================================
# pre-commit: 提交前把本次暂存文件里的中文全角标点转成半角
# ----------------------------------------------------------------------------
# 由 git 通过 core.hooksPath=.githooks 调用(启用方式见 scripts/autorun.py 顶部
# 那段长注释). 这个文件跟随仓库一起被提交, 所以换机器或重新 clone 之后不会像
# .git/hooks 里的东西那样静默失效.
#
# 流程:
#   git diff --cached --name-only -z --diff-filter=ACM
#     -> 取出本次暂存的**新增/修改/复制**文件(不含删除)
#     -> import scripts/autorun.py, 对每个文件调 fix_file()(原地改写)
#     -> 只把**真正被改写**的文件重新 git add, 让修正进入这一次提交
#
# [为什么钩子是 Python 而不是 bash]
# 转义映射表本来就在 scripts/autorun.py 里. 原来的 bash 钩子只能用
# "python3 scripts/autorun.py <files>" 再逐行解析它 stdout 里的
# `[fix_punctuation] fixed: <file>` 来判断哪些文件被改了 -- 那是一条隐式的
# 字符串协议: 谁动一下那行日志的格式, "重新暂存"就会静默失效, 而且失败时不报错.
# 现在钩子直接 import 那个模块拿返回值, 协议消失. 同时 bash 那一层也没了,
# 不必再为"参数里有空格/中文文件名"做数组与 -z 的体操.
#
# 附带好处: 原 bash 版本必须把钩子自己**排到最后**处理, 因为 bash 是边读边执行,
# 改写一个正在运行的脚本很危险. CPython 在执行前就把整个源文件编译完, 这条约束
# 自动作废, 排序逻辑可以整块删掉.
#
# 注意:
#   * 钩子只帮忙, 不设卡: 任何异常都只警告, 永远 exit 0.
#   * 本文件自己也在修正范围内, 所以这里的注释一律只用半角标点.
#   * 钩子本身是 Python: 没装 python3 的机器上 git 会直接报 "bad interpreter",
#     比"钩子静默不生效"更容易发现; 真要停用就 `git config --unset core.hooksPath`.
# ============================================================================
import os
import subprocess
import sys
from pathlib import Path


def warn(message):
    print(f"[pre-commit] 警告: {message}", file=sys.stderr)


def git(root, args, **kwargs):
    return subprocess.run(["git"] + args, cwd=str(root), check=True, **kwargs)


def staged_files(root):
    """暂存区里本次新增/修改/复制的文件.

    `-z` 是为了正确处理空格与中文文件名: 输出以 NUL 分隔, 不走 git 的引号转义.
    """
    result = git(
        root,
        ["diff", "--cached", "--name-only", "-z", "--diff-filter=ACM"],
        capture_output=True,
    )
    return [os.fsdecode(chunk) for chunk in result.stdout.split(b"\0") if chunk]


def main():
    try:
        root = Path(
            git(Path.cwd(), ["rev-parse", "--show-toplevel"], capture_output=True)
            .stdout.decode("utf-8", "replace")
            .strip()
        )
    except (subprocess.CalledProcessError, OSError):
        # 不在 git 工作树里(或者没装 git): 没什么可做的.
        return 0

    try:
        targets = staged_files(root)
    except (subprocess.CalledProcessError, OSError) as err:
        warn(f"读暂存区失败({err}), 跳过标点自动转换.")
        return 0

    if not targets:
        return 0

    # 钩子不该往工作树里丢东西: 不加这一行, 下面那次 import 会在 scripts/ 下生成
    # __pycache__/*.pyc, 于是每次提交都在工作树里多出一个未跟踪目录.
    sys.dont_write_bytecode = True
    scripts_dir = root / "scripts"
    sys.path.insert(0, str(scripts_dir))
    try:
        import autorun
    except Exception as err:  # noqa: BLE001 -- 钩子绝不因为自身问题阻断提交
        warn(f"导入 scripts/autorun.py 失败({err}), 跳过标点自动转换.")
        return 0
    finally:
        sys.path.pop(0)

    changed = []
    for name in targets:
        path = root / name
        if not path.is_file():
            continue  # 暂存之后又在工作区被删掉的文件
        try:
            if autorun.fix_file(path):
                changed.append(name)
                print(f"[fix_punctuation] fixed: {name}")
        except UnicodeDecodeError:
            continue  # 二进制文件不处理
        except OSError as err:
            warn(f"标点转换失败: {name}: {err}")

    if changed:
        # 只 add 真正改过的文件: 否则会把暂存文件在工作区里的其他改动一起带进这次提交.
        try:
            git(root, ["add", "--"] + changed)
        except (subprocess.CalledProcessError, OSError) as err:
            warn(f"git add 失败({err}), 改过的文件没有重新暂存.")

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as err:  # noqa: BLE001 -- 钩子的职责是帮忙, 不是设卡
        warn(f"未预期的错误({err}), 已放行这次提交.")
        sys.exit(0)
