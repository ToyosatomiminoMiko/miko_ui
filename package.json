{
  "name": "miko_ui",
  "type": "module",
  "private": true,
  "description": "GraphCalc 的通用 UI 库: DOM 原语 + 控件 + 布局 + 桌面窗口系统 + 主题",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "ui",
    "dom",
    "typescript",
    "signals",
    "widgets",
    "desktop",
    "window-manager"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToyosatomiminoMiko/miko_ui.git"
  },
  "homepage": "https://github.com/ToyosatomiminoMiko/miko_ui#readme",
  "bugs": {
    "url": "https://github.com/ToyosatomiminoMiko/miko_ui/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/styles.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/widgets.css": "./styles/widgets.css",
    "./styles/desktop.css": "./styles/desktop.css",
    "./styles/editor.css": "./styles/editor.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && npm run typecheck",
    "dev": "npm run build && vite example",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "test": "node scripts/check_ui_boundary.mjs && vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "katex": "^0.18.5"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.4.1",
    "katex": "^0.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}